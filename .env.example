# Copy this file to `.env` and fill in the values (see README.md, section 3).
# NEVER commit `.env`. It is listed in .gitignore.
# Comments are on their own lines so the file can be pasted safely into
# hosting dashboards (e.g. Railway's Raw Editor).

# ───────── App ─────────
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# Protects GET /admin/chats (send it as the X-Admin-Key header). Use a long random string.
ADMIN_API_KEY=change-me-long-random-string

# ───────── WhatsApp (Meta) ─────────
# System User permanent token (README 2.2, Step E)
WA_ACCESS_TOKEN=
# API Setup → Phone number ID (NOT the phone number itself)
WA_PHONE_NUMBER_ID=
# API Setup → WhatsApp Business Account ID
WA_BUSINESS_ACCOUNT_ID=
# App settings → Basic → App secret (used to check webhook signatures)
WA_APP_SECRET=
# Any string you invent; type the same value into Meta's webhook settings
WA_VERIFY_TOKEN=
# Latest Graph API version shown in your Meta app
GRAPH_API_VERSION=v23.0

# ───────── Google Gemini (AI brain + voice, one key) ─────────
# aistudio.google.com → Get API key
GEMINI_API_KEY=
# Current stable Flash model: check ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# low = faster & cheaper answers (low | medium | high)
GEMINI_THINKING_LEVEL=low
# Voice note → text (any Gemini model that understands audio)
GEMINI_STT_MODEL=gemini-3.8-flash
# Text → voice (a Gemini TTS model; check the models page for the current one)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# A female prebuilt voice. Try them in AI Studio → Generate speech,
# e.g. Sulafat (warm), Kore, Aoede, Leda, Despina, Achernar
GEMINI_TTS_VOICE=Sulafat

# ───────── Storage ─────────
# Local: redis://localhost:6379/0 · Upstash: rediss://default:password@host:6379
REDIS_URL=redis://localhost:6379/0
# Optional, for the later move to Postgres (not used yet)
DATABASE_URL=

# ───────── Bot behaviour ─────────
# Used when a farmer's language is not known yet: gu-IN | hi-IN | en-IN
DEFAULT_LANGUAGE=gu-IN
# Messages per farmer per day (IST)
DAILY_MESSAGE_LIMIT=50
# Longer voice notes get a polite "please keep it shorter" reply
MAX_VOICE_SECONDS=120
# true = send text as well as voice for voice questions (costs 2 WhatsApp messages)
VOICE_REPLY_ALSO_TEXT=false

# ───────── Monitoring (optional) ─────────
# Only used if you also `pip install sentry-sdk`
SENTRY_DSN=
